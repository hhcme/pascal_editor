{
  "$schema": "./asset-source-ledger.schema.json",
  "version": 1,
  "defaultLegacyPolicy": {
    "sourceId": "legacy-catalog",
    "licenseId": "license-review-needed",
    "reviewStatus": "needs-review",
    "distribution": "bundled",
    "notes": "Existing bundled assets predate the asset source ledger. Do not treat them as open assets until each source is reviewed."
  },
  "approvedSources": [
    {
      "id": "poly-haven",
      "name": "Poly Haven",
      "homepage": "https://polyhaven.com/",
      "licenseId": "CC0-1.0",
      "licenseUrl": "https://polyhaven.com/license",
      "integrationMode": "curated-download",
      "bestFor": [
        "hdris",
        "pbr-materials",
        "decor-models"
      ],
      "notes": "Use for high-quality environment lighting, materials, and selected decor models."
    },
    {
      "id": "ambientcg",
      "name": "ambientCG",
      "homepage": "https://ambientcg.com/",
      "licenseId": "CC0-1.0",
      "licenseUrl": "https://docs.ambientcg.com/license/",
      "integrationMode": "curated-download",
      "bestFor": [
        "pbr-materials",
        "surface-scans",
        "selected-models"
      ],
      "notes": "Use first for floor, wall, stone, wood, fabric, and tile material coverage."
    },
    {
      "id": "kenney",
      "name": "Kenney",
      "homepage": "https://kenney.nl/assets",
      "licenseId": "CC0-1.0",
      "licenseUrl": "https://kenney.nl/assets",
      "integrationMode": "curated-download",
      "bestFor": [
        "low-poly-furniture",
        "city-props",
        "prototype-assets"
      ],
      "notes": "Use for lightweight baseline coverage. Keep visual style separate from realistic packs."
    },
    {
      "id": "quaternius",
      "name": "Quaternius",
      "homepage": "https://quaternius.com/",
      "licenseId": "CC0-1.0",
      "licenseUrl": "https://quaternius.com/",
      "integrationMode": "curated-download",
      "bestFor": [
        "modular-building-parts",
        "nature",
        "props"
      ],
      "notes": "Use selected glTF/Blend packs only after style and scale normalization."
    },
    {
      "id": "smithsonian-open-access",
      "name": "Smithsonian Open Access",
      "homepage": "https://www.si.edu/openaccess",
      "licenseId": "CC0-1.0",
      "licenseUrl": "https://www.si.edu/openaccess/faq",
      "integrationMode": "curated-download",
      "bestFor": [
        "art-decor",
        "sculptures",
        "museum-objects"
      ],
      "notes": "Use only objects explicitly marked CC0. Avoid implying endorsement or using Smithsonian marks."
    },
    {
      "id": "sketchfab-api",
      "name": "Sketchfab Download API",
      "homepage": "https://sketchfab.com/developers/download-api",
      "licenseId": "per-asset-creative-commons",
      "licenseUrl": "https://sketchfab.com/developers/download-api/guidelines",
      "integrationMode": "user-authenticated-import",
      "bestFor": [
        "long-tail-user-import"
      ],
      "notes": "Do not bundle by default. Preserve author, source URL, and license with every imported asset."
    },
    {
      "id": "findtop-procedural",
      "name": "Findtop Procedural Asset Kit",
      "homepage": "https://findtop.local/assets/procedural",
      "licenseId": "CC0-1.0",
      "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
      "integrationMode": "generated",
      "bestFor": [
        "life-atmosphere-baseline",
        "scale-reference",
        "low-poly-vegetation",
        "pets"
      ],
      "notes": "Project-generated low-poly baseline models for bundled people, animals, and plants."
    }
  ],
  "licensePolicy": {
    "bundledAllowlist": [
      "CC0-1.0"
    ],
    "importAllowlist": [
      "CC0-1.0",
      "CC-BY-4.0"
    ],
    "rejectByDefault": [
      "unknown",
      "license-review-needed",
      "CC-BY-NC",
      "CC-BY-ND",
      "CC-BY-SA",
      "GPL",
      "LGPL",
      "editorial",
      "royalty-free-marketplace"
    ]
  },
