{
  "name": "editor",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "set -a && . ./.env 2>/dev/null; set +a; turbo run dev --env-mode=loose",
    "guide:debug": "bun ./scripts/guide-detection-debug.ts",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check",
    "check:fix": "biome check --write",
    "check-types": "turbo run check-types",
    "clean:cache": "rm -rf .turbo apps/*/.turbo apps/*/.next/dev packages/*/.turbo tooling/*/.turbo",
    "clean:artifacts": "rm -rf apps/*/.next apps/*/out packages/*/dist",
    "assets:manifest": "node ./tooling/assets/generate-asset-manifest.cjs",
    "assets:check": "node ./tooling/assets/generate-asset-manifest.cjs --check",
    "assets:thumbs": "node ./tooling/assets/render-item-thumbnails.cjs",
    "materials:ambientcg": "node ./tooling/assets/download-ambientcg-materials.cjs",
    "materials:polyhaven": "node ./tooling/assets/download-polyhaven-materials.cjs",
    "materials:polyhaven:variants": "node ./tooling/assets/append-polyhaven-material-variants.cjs",
    "materials:sync-packs": "node ./tooling/assets/sync-material-pack-catalog.cjs",
    "materials:manifest": "node ./tooling/assets/generate-material-manifest.cjs",
    "materials:check": "node ./tooling/assets/generate-material-manifest.cjs --check",
    "kill": "lsof -ti:3002 | xargs kill -9 2>/dev/null || echo 'No processes found on port 3002'",
    "release": "gh workflow run release.yml -f package=both -f bump=patch",
    "release:viewer": "gh workflow run release.yml -f package=viewer -f bump=patch",
    "release:core": "gh workflow run release.yml -f package=core -f bump=patch",
    "release:minor": "gh workflow run release.yml -f package=both -f bump=minor",
    "release:major": "gh workflow run release.yml -f package=both -f bump=major"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/pngjs": "^6.0.5",
    "dotenv-cli": "^11.0.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "turbo": "^2.8.15",
    "typescript": "5.9.3",
    "ultracite": "^7.2.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ]
}
